{
   "name": "cubenho",
   "version": "1.0.8",
   "description": "cubenho - Giải trắc nghiệm tự động hoàn toàn miễn phí bằng AI với độ chính xác 100%.",
   "manifest_version": 3,
   "action": {
      "default_icon": {
         "16": "icons/icon16.png",
         "32": "icons/icon32.png",
         "48": "icons/icon48.png",
         "128": "icons/icon128.png"
      },
      "default_popup": "popup.html",
      "default_title": "cubenho"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "capture-answer": {
         "description": "Chụp và giải đáp án",
         "suggested_key": {
            "default": "Alt+Q"
         }
      },
      "toggle-auto-wayground": {
         "description": "Bật hoặc tắt Auto Wayground",
         "suggested_key": {
            "default": "Alt+A"
         }
      },
      "toggle-extension": {
         "description": "Bật hoặc tắt QuizPeek",
         "suggested_key": {
            "default": "Alt+X"
         }
      }
   },
   "content_scripts": [
      {
         "js": [ "content.js" ],
         "matches": [ "https://*/*", "http://*/*" ],
         "run_at": "document_idle"
      }
   ],
   "permissions": [
      "activeTab",
      "storage",
      "scripting"
   ],
   "host_permissions": [
      "https://generativelanguage.googleapis.com/*",
      "https://*/*",
      "http://*/*"
   ],
   "icons": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
   }
}
